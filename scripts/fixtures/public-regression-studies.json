          ]
        },
        {
          "column": "illness",
          "kind": "continuous",
          "label": "Recent illnesses",
          "unit": "illnesses",
          "reference": 0,
          "increment": 1,
          "knots": []
        },
        {
          "column": "health",
          "kind": "continuous",
          "label": "Health questionnaire",
          "unit": "points",
          "reference": 0,
          "increment": 1,
          "knots": []
        },
        {
          "column": "nchronic",
          "kind": "categorical",
          "label": "Nonlimiting chronic",
          "reference": "no",
          "levels": [
            "no",
            "yes"
          ]
        }
      ],
      "independent_rows": true,
      "study_design": "cross_sectional",
      "context": "Public AER 1.2-17 DoctorVisits engineering validation: 1977-1978 Australian Health Survey cross-section. Unweighted conditional associations only; the retained data provide no survey design weights. Age is years divided by 100, so an increment of 0.1 is 10 years. Same two-week count window, no source duration offset. No new clinical or population inference. The unchanged age/100 values are measured in 100-year units (0.4 means 40 years, +0.1 means +10 years). Illness is a count over the same two weeks; health is the original Goldberg questionnaire score in points."
    }
